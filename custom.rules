# =============================================================================
# custom.rules — CodeAlpha Cyber Security Internship, Task 4
# Network Intrusion Detection System (Suricata)
# =============================================================================
# These are DETECTION-ONLY signatures. They match on traffic patterns to
# raise alerts; they do not block, exploit, or generate attacks themselves.
# SIDs 9000000-9000999 are reserved here as a "local" custom range so they
# never collide with official Emerging Threats / Suricata SIDs.
# =============================================================================

# ---------------------------------------------------------------------------
# 1. Reconnaissance — Port scan detection (many SYNs from one host, no ACK)
#    Suricata's `flags:S,12` matches a SYN with no ACK/other flags set.
#    `threshold` fires only after 15+ distinct attempts in 10s from one host,
#    which avoids flagging a single legitimate connection attempt.
# ---------------------------------------------------------------------------
alert tcp any any -> $HOME_NET any (msg:"CUSTOM Possible TCP Port Scan Detected"; \
    flags:S,12; threshold:type both, track by_src, count 15, seconds 10; \
    classtype:attempted-recon; sid:9000001; rev:1;)

# ---------------------------------------------------------------------------
# 2. Reconnaissance — ICMP sweep / flood (many pings from one host quickly)
# ---------------------------------------------------------------------------
alert icmp any any -> $HOME_NET any (msg:"CUSTOM Possible ICMP Ping Sweep/Flood"; \
    itype:8; threshold:type both, track by_src, count 20, seconds 5; \
    classtype:attempted-recon; sid:9000002; rev:1;)

# ---------------------------------------------------------------------------
# 3. Oversized ICMP packet (classic "Ping of Death" style indicator)
# ---------------------------------------------------------------------------
alert icmp any any -> $HOME_NET any (msg:"CUSTOM Oversized ICMP Packet (Possible DoS Probe)"; \
    itype:8; dsize:>1024; classtype:attempted-dos; sid:9000003; rev:1;)

# ---------------------------------------------------------------------------
# 4. Cleartext credentials submitted over unencrypted HTTP
#    Flags any HTTP request body containing "password=" — a strong indicator
#    of a login form submitted without TLS.
# ---------------------------------------------------------------------------
alert http any any -> any any (msg:"CUSTOM Cleartext Password Submitted Over HTTP"; \
    flow:to_server,established; http.method; content:"POST"; \
    http.request_body; content:"password="; nocase; \
    classtype:policy-violation; sid:9000004; rev:1;)

# ---------------------------------------------------------------------------
# 5. Known scanning/attack tool user-agents
# ---------------------------------------------------------------------------
alert http any any -> any any (msg:"CUSTOM Suspicious Scanner User-Agent (sqlmap)"; \
    flow:to_server,established; http.user_agent; content:"sqlmap"; nocase; \
    classtype:attempted-recon; sid:9000005; rev:1;)

alert http any any -> any any (msg:"CUSTOM Suspicious Scanner User-Agent (Nikto)"; \
    flow:to_server,established; http.user_agent; content:"Nikto"; nocase; \
    classtype:attempted-recon; sid:9000006; rev:1;)

alert http any any -> any any (msg:"CUSTOM Suspicious Scanner User-Agent (Nmap NSE)"; \
    flow:to_server,established; http.user_agent; content:"Nmap Scripting Engine"; nocase; \
    classtype:attempted-recon; sid:9000007; rev:1;)

# ---------------------------------------------------------------------------
# 6. FTP anonymous login attempt
# ---------------------------------------------------------------------------
alert ftp any any -> any any (msg:"CUSTOM FTP Anonymous Login Attempt"; \
    flow:to_server,established; content:"USER anonymous"; nocase; \
    classtype:policy-violation; sid:9000008; rev:1;)

# ---------------------------------------------------------------------------
# 7. Suspicious long DNS query (possible DNS tunneling / exfiltration)
# ---------------------------------------------------------------------------
alert dns any any -> any any (msg:"CUSTOM Unusually Long DNS Query (Possible Tunneling)"; \
    dns.query; bsize:>60; classtype:bad-unknown; sid:9000009; rev:1;)

# ---------------------------------------------------------------------------
# 8. Plaintext Telnet traffic (insecure protocol in use at all)
# ---------------------------------------------------------------------------
alert tcp any any -> any 23 (msg:"CUSTOM Telnet Traffic Detected (Insecure Protocol)"; \
    flow:to_server,established; classtype:policy-violation; sid:9000010; rev:1;)
